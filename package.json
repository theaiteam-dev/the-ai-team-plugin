{
  "name": "@ai-team/root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A(i)-Team monorepo workspace root",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "build:shared": "bun run --filter '@ai-team/shared' build",
    "test": "vitest run",
    "test:all": "bun run --filter './packages/*' test",
    "test:e2e": "flowspec run specs/",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "check:cli": "cd packages/ateam-cli && go build ./... && go vet ./... && go test ./...",
    "check:commits": "bunx commitlint --from origin/main --to HEAD --config .commitlintrc.yml",
    "check": "bun run build:shared && bun run test && bun run --filter './packages/*' check && bun run check:cli"
  },
  "devDependencies": {
    "flowspec": "^0.1.2",
    "typescript": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
