{
  "ateamCliVersion": "latest",
  "packageManager": "bun",
  "checks": {
    "lint": null,
    "unit": null,
    "e2e": null
  },
  "precheck": ["lint", "unit"],
  "postcheck": ["lint", "unit"],
  "devServer": {
    "url": "http://localhost:5566",
    "start": "cd packages/kanban-viewer && npm run dev",
    "restart": "docker compose restart",
    "managed": false
  },
  "surfaces": ["web"],
  "qa": {
    "seed": "cd packages/kanban-viewer && npm run seed",
    "account": { "credential_env": "ATEAM_QA_PASSWORD" },
    "drive": "flowspec"
  },
  "testing_level": "critical-path",
  "evidence": { "prd_work": "video+screenshots", "default": "screenshots" },
  "review_tier": "hands-on",
  "pricing": {
    "models": {
      "claude-opus-4-8": {
        "input_per_1m": 5.00,
        "output_per_1m": 25.00,
        "cache_read_per_1m": 0.50
      },
      "claude-opus-4-7": {
        "input_per_1m": 5.00,
        "output_per_1m": 25.00,
        "cache_read_per_1m": 0.50
      },
      "claude-opus-4-6": {
        "input_per_1m": 15.00,
        "output_per_1m": 75.00,
        "cache_read_per_1m": 1.50
      },
      "claude-sonnet-4-6": {
        "input_per_1m": 3.00,
        "output_per_1m": 15.00,
        "cache_read_per_1m": 0.30
      },
      "claude-haiku-4-5-20251001": {
        "input_per_1m": 0.80,
        "output_per_1m": 4.00,
        "cache_read_per_1m": 0.08
      }
    },
    "fallback": {
      "input_per_1m": 3.00,
      "output_per_1m": 15.00,
      "cache_read_per_1m": 0.30
    }
  }
}
